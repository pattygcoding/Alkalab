{
  "name": "alkalab",
  "version": "0.1.0",
  "private": true,
  "description": "Alkalab - a falling-sand chemistry lab written in Nim and compiled to WebAssembly",
  "keywords": ["wasm", "nim", "simulation", "cellular-automata", "falling-sand", "chemistry"],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node nim/build.mjs",
    "serve": "node scripts/serve.mjs nim/web",
    "start": "npm run build && npm run serve",
    "test": "nim c -r --hints:off --warnings:off nim/tests/alkalab_tests.nim",
    "test:wasm": "node nim/tests/wasm_smoke.mjs",
    "test:js": "npm run test:wasm"
  },
  "engines": {
    "node": ">=18"
  }
}
